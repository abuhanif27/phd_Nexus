# =============================================================================
# NexusCare Backend - Production Environment Variables
# Copy to .env and fill in real values before deploying
# =============================================================================

# --- Core Django ---
DJANGO_SECRET=CHANGE_ME_generate_with_python_c_import_secrets_print_secrets_token_urlsafe_64
DEBUG=0
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
SECURE_SSL_REDIRECT=True

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://nexuscare:STRONG_PASSWORD@db:5432/nexuscare

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# --- CORS ---
FRONTEND_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-production-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=NexusCare <your-production-email@gmail.com>

# --- Celery ---
USE_CELERY=1

# --- Media ---
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# --- Hugging Face AI ---
HF_TOKEN=your_production_hf_token
HF_REPO_ID=hanifgp2500/nexuscare-medical-ai
USE_HF_MODELS=True
USE_HF_INFERENCE_API=True
USE_LOCAL_AI_MODELS=False
HF_LLM_MODEL=openai/gpt-oss-20b
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_NER_MODEL=d4data/biomedical-ner-all
HF_OCR_MODEL=microsoft/trocr-base-printed

# --- Resend (transactional email) ---
RESEND_API_KEY=your_resend_api_key

# --- BioBERT ---
BIOBERT_MIN_SCORE=0.5
BIOBERT_MAX_CHUNKS=5
BIOBERT_CHUNK_CHARS=1500
BIOBERT_CORPUS_MAX_CHARS=6000
BIOBERT_CACHE_TTL_SECONDS=86400
