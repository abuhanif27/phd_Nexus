# Django Settings
DJANGO_SECRET=your-secret-key-change-in-production-use-python-secrets
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# JWT Settings
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=30

# Media/File Settings
MEDIA_ROOT=./media
MEDIA_URL=/media/

# Celery/Redis (optional - set USE_CELERY=1 to enable)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=0

# NLP/ML paths
FAISS_INDEX_PATH=./ai_index/faiss.index
EMB_META_DB=sqlite
SYMPTOM_MODEL_PATH=./ai_models/specialist_clf.joblib
SPACY_MODEL=en_core_web_sm
REMOTE_BRAIN_URL=
RESEND_API_KEY=your_resend_api_key_here

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Hugging Face Settings
HF_TOKEN=your_huggingface_api_token_here
HF_REPO_ID=hanifgp2500/nexuscare-medical-ai
USE_HF_MODELS=True
USE_HF_INFERENCE_API=True
USE_LOCAL_AI_MODELS=False
HF_INFERENCE_ENDPOINT=
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_NER_MODEL=samrawal/bert-base-uncased_clinical-ner
HF_OCR_MODEL=naver-clova-ix/donut-base-finetuned-docvqa

# --- BioBERT / clinical-NER for the Report Summary feature -------------------
# Default model `d4data/biomedical-ner-all` (~110M, BERT-based) returns
# DISEASE_DISORDER, MEDICATION, SIGN_SYMPTOM, DOSAGE, etc. and runs on the free
# HF Inference API.  Other free-tier-friendly options:
#   HF_NER_MODEL=samrawal/bert-base-uncased_clinical-ner   # i2b2-trained
#   HF_NER_MODEL=Clinical-AI-Apollo/Medical-NER             # general clinical
#   HF_NER_MODEL=alvaroalon2/biobert_diseases_ner           # diseases only
#   HF_NER_MODEL=blaze999/Medical-NER                       # MedMentions-style
#
# To run the same model locally instead of via HF Cloud, set
# USE_HF_INFERENCE_API=False and USE_LOCAL_AI_MODELS=True (downloads the
# model on first use).  HF_TOKEN is still used for gated model access.
BIOBERT_MIN_SCORE=0.5
BIOBERT_MAX_CHUNKS=5
BIOBERT_CHUNK_CHARS=1500
BIOBERT_CORPUS_MAX_CHARS=6000
BIOBERT_CACHE_TTL_SECONDS=86400

