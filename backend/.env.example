# Django Settings
DJANGO_SECRET=your-secret-key-change-in-production-use-python-secrets
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# JWT Settings
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=30

# Media/File Settings
MEDIA_ROOT=./media
MEDIA_URL=/media/

# Celery/Redis (optional - set USE_CELERY=1 to enable)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=0

# NLP/ML paths
FAISS_INDEX_PATH=./ai_index/faiss.index
EMB_META_DB=sqlite
SYMPTOM_MODEL_PATH=./ai_models/specialist_clf.joblib
SPACY_MODEL=en_core_web_sm

